            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_{{$timestamp}}\",\n  \"email\": \"demo_{{$timestamp}}@example.com\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
