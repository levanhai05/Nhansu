    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Đăng nhập",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "login"
              ]
            },
            "description": "Quyền: Công khai. HTTP mong đợi: 200. Chỉ chạy thao tác ghi trên database thử nghiệm.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set(\"accessToken\", data.token);",
                  "  if (data.refreshToken) pm.collectionVariables.set(\"refreshToken\", data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Đăng ký User",
          "request": {
            "method": "POST",
            "header": [
