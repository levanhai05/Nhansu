            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) { pm.collectionVariables.unset(\"refreshToken\"); pm.collectionVariables.unset(\"accessToken\"); }"
