@model NhansuFE.Models.WorkShiftCreateVm
@{
    ViewData["Title"] = "Quản lý ca làm việc";
    var shifts = ViewBag.Shifts as List<NhansuFE.Models.WorkShiftVm> ?? new();
    var assignments = ViewBag.Assignments as List<NhansuFE.Models.EmployeeShiftAssignmentVm> ?? new();
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h3>Quản lý ca làm việc</h3><div class="text-muted">Tạo ca, cập nhật và phân ca cho nhân viên</div></div>
    <a class="btn btn-outline-secondary" href="/Attendances">Quay lại chấm công</a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm"><div class="card-body">
            <h5 class="mb-3">Tạo ca mới</h5>
            <form asp-action="Create" method="post">
                <div class="mb-3"><label class="form-label">Tên ca</label><input asp-for="Name" class="form-control" required maxlength="100" /></div>
                <div class="row">
                    <div class="col-6 mb-3"><label class="form-label">Bắt đầu</label><input asp-for="StartTime" type="time" class="form-control" required /></div>
                    <div class="col-6 mb-3"><label class="form-label">Kết thúc</label><input asp-for="EndTime" type="time" class="form-control" required /></div>
                    <div class="col-6 mb-3"><label class="form-label">Nghỉ từ</label><input asp-for="BreakStartTime" type="time" class="form-control" /></div>
                    <div class="col-6 mb-3"><label class="form-label">Nghỉ đến</label><input asp-for="BreakEndTime" type="time" class="form-control" /></div>
                </div>
                <div class="mb-3"><label class="form-label">Ân hạn (phút)</label><input asp-for="GraceMinutes" type="number" min="0" max="60" class="form-control" /></div>
                <button class="btn btn-primary">Tạo ca</button>
            </form>
        </div></div>

        <div class="card shadow-sm mt-4"><div class="card-body">
            <h5 class="mb-3">Phân ca nhân viên</h5>
            <form asp-action="Assign" method="post">
                <div class="mb-3"><label class="form-label">Mã nhân viên</label><input name="EmployeeId" type="number" min="1" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Ca làm việc</label>
                    <select name="WorkShiftId" class="form-select" required>
                        <option value="">-- Chọn ca --</option>
                        @foreach (var s in shifts.Where(x => x.IsActive)) { <option value="@s.Id">@s.Name (@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm"))</option> }
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">Ngày bắt đầu hiệu lực</label><input name="EffectiveFrom" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                <button class="btn btn-success">Phân ca</button>
                <div class="form-text">Nếu nhân viên đang có ca, ca cũ sẽ kết thúc vào ngày trước ngày bắt đầu ca mới.</div>
            </form>
        </div></div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm mb-4"><div class="card-body">
            <h5 class="mb-3">Danh sách ca</h5>
            <div class="table-responsive"><table class="table table-hover">
                <thead><tr><th>Tên ca</th><th>Thời gian</th><th>Nghỉ</th><th>Ân hạn</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var s in shifts) {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                        <td>@(s.BreakStartTime?.ToString(@"hh\:mm") ?? "—") - @(s.BreakEndTime?.ToString(@"hh\:mm") ?? "—")</td>
                        <td>@s.GraceMinutes phút</td>
                        <td>@(s.IsActive ? "Đang hoạt động" : "Đã ngừng")</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            @if (s.IsActive) {
                                <form asp-action="Deactivate" asp-route-id="@s.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Ngừng ca này?')">Ngừng</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        </div></div>

        <div class="card shadow-sm"><div class="card-body">
            <h5 class="mb-3">Lịch sử phân ca</h5>
            <div class="table-responsive"><table class="table table-sm table-hover">
                <thead><tr><th>Nhân viên</th><th>Ca</th><th>Từ ngày</th><th>Đến ngày</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in assignments.OrderByDescending(x => x.EffectiveFrom)) {
                    <tr><td>@a.EmployeeName (#@a.EmployeeId)</td><td>@a.WorkShiftName</td><td>@a.EffectiveFrom.ToString("dd/MM/yyyy")</td><td>@(a.EffectiveTo?.ToString("dd/MM/yyyy") ?? "Chưa kết thúc")</td><td>@(a.IsCurrent ? "Hiện tại" : "")</td></tr>
                }
                @if (assignments.Count == 0) { <tr><td colspan="5" class="text-center text-muted">Chưa có lịch phân ca.</td></tr> }
                </tbody>
            </table></div>
        </div></div>
    </div>
</div>
